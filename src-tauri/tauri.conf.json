{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokenstreak",
  "version": "0.1.0",
  "identifier": "app.tokenstreak.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popover",
        "url": "index.html?view=popover",
        "title": "Tokenstreak",
        "width": 380,
        "height": 580,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": true,
        "focus": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "dashboard",
        "url": "index.html?view=dashboard",
        "title": "Tokenstreak",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Goals, streaks and history for your AI coding tokens",
    "longDescription": "Tokenstreak turns the token usage of Claude Code, Codex CLI and Gemini CLI into daily goals, streaks, achievements and a history worth sharing. Everything stays on your Mac: it reads usage numbers only, never your prompts or responses.",
    "copyright": "© 2026 Tokenstreak contributors. MIT License.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  }
}
